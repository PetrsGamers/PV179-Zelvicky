@model IEnumerable<LeaderboardViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Leaderboard";
}
<script>
    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    })
</script>
<h2>Leaderboard</h2>

<table class="table">
    <thead>
    <tr>
        <th>Rank</th>
        <th>Username</th>
        <th>Distinct Cap Count</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in Model)
    {
        <tr>
            <td>@entry.Rank</td>
            @if (entry.isPremium)
            {
                <td>
                    <span data-toggle="tooltip" title="Premium User" data-placement="bottom">
                        <strong class="text-warning">@entry.Username</strong> ⭐
                    </span>
                </td>
            }
            else
            {
                <td>@entry.Username</td>
            }
            <td>@entry.DistinctCapCount</td>
        </tr>
    }
    </tbody>
</table>
