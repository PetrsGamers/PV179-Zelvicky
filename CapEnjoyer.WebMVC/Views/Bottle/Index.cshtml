@model IEnumerable<BottleViewModel>

@{
Layout = "_Layout";
ViewData["Title"] = "Bottle List";
}

<h2>Bottle List</h2>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Voltage</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var bottle in Model)
    {
    <tr>
        <td>@bottle.Name</td>
        <td>@bottle.Description</td>
        <td>@bottle.Voltage</td>
        <td>
            <a href="@Url.Action("Details", "Bottle", new { id = bottle.Id })">Details</a> |
            <a href="@Url.Action("Edit", "Bottle", new { id = bottle.Id })">Edit</a> |
            <a href="@Url.Action("Delete", "Bottle", new { id = bottle.Id })">Delete</a>
        </td>
    </tr>
    }
    </tbody>
</table>
