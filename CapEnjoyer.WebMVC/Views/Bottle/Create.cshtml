@model BottleCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Bottle";
}

<h2>Create Bottle</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_BottleFormPartial", Model)
    <button type="submit">Create</button>
</form>

<a asp-action="Index" asp-controller="Bottle" class="btn btn-secondary">Back to List</a>
