@model BottleCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Bottle";
}

<h2>Edit Bottle</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_BottleFormPartial", Model)
    <button type="submit" class="btn btn-primary"
            onclick="return confirm('To maintain data quality, the bottle cannot be edited directly. Our team will review your edit request soon, and if approved, the changes will be updated in the database.')">
        Save
    </button>
</form>

<a asp-action="Index" asp-controller="Bottle" class="btn btn-secondary">Back to List</a>
