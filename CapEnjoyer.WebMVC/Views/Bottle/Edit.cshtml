@model BottleViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Bottle";
}

<h2>Edit Bottle</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label>Description</label>
        <textarea asp-for="Description"></textarea>
    </div>
    <div>
        <label>Voltage</label>
        <input asp-for="Voltage" type="number" step="0.01" />
    </div>
    <div>
        <label>Drink Type</label>
        <input asp-for="DrinkType" />
    </div>
    <div>
        <label>Producer</label>
        <select asp-for="Producer">
            <!-- Producer options -->
        </select>
    </div>
    <div>
        <label>Caps</label>
        <input asp-for="Caps" />
    </div>
    <div>
        <label>Bottle Picture</label>
        <input asp-for="BottlePicture" type="file" />
    </div>
    <button type="submit" onclick="return confirm('To maintain data quality, the bottle cannot be edited directly. Our team will review your edit request soon, and if approved, the changes will be updated in the database.')">Save</button>
</form>

<a asp-action="Index" asp-controller="Bottle">Back to List</a>
