@model ProducerViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Producer";
}

<h2>Edit Producer</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label>City</label>
        <input asp-for="City" />
    </div>
    <div>
        <label>Description</label>
        <textarea asp-for="Description"></textarea>
    </div>
    <div>
        <label>Country</label>
        <select asp-for="Country">
            <!-- Country options here -->
        </select>
    </div>
    <div>
        <label>Is Edit For</label>
        <input asp-for="IsEditFor" />
    </div>
    <button type="submit">Save</button>
</form>

<a asp-action="Index" asp-controller="Producer">Back to List</a>
