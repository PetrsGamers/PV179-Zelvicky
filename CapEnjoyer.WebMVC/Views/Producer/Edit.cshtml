@model ProducerCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Producer";
}

<h2>Edit Producer</h2>

<form asp-action="Edit" method="post">
    @await Html.PartialAsync("_ProducerFormPartial", Model)
    <button type="submit"
            onclick="return confirm('To maintain data quality, the producer cannot be edited directly. Our team will review your edit request soon, and if approved, the changes will be updated in the database.')">
        Save
    </button>
</form>

<a asp-action="Index" asp-controller="Producer">Back to List</a>
