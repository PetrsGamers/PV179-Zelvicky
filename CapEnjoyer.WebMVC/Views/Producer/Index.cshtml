@model IEnumerable<ProducerListViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Producer List";
}

<h2>Producer List</h2>

<a asp-action="Create" asp-controller="Producer" class="btn btn-primary">Add New Producer</a>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>City</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var producer in Model)
    {
        <tr>
            <td>@producer.Name</td>
            <td>@producer.City</td>
            <td>
                <a href="@Url.Action("Details", "Producer", new { id = producer.Id })" class="btn btn-info btn-sm">
                    <i class="fas fa-info"></i> Details
                </a>
                |
                         <a href="@Url.Action("Edit", "Producer", new { id = producer.Id })" class="btn btn-info btn-sm">
                             <i class="fas fa-edit"></i> Edit
                         </a>
                    @if (User.IsInRole("Admin"))
                 {

                         <form action="@Url.Action("Delete", "Producer", new { id = producer.Id })" method="post"
                               style="display:inline;">
                             <button type="submit" class="btn btn-danger btn-sm"
                                     onclick="return confirm('Are you sure you want to delete this producer?')">
                                 <i class="fas fa-trash-alt"></i> Delete
                             </button>
                         </form>
                 }
            </td>
        </tr>
    }
    </tbody>
</table>
