@model ColorViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Color";
}

<h2>Edit Color</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id"/>
    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control"/>
    </div>
    <div>
        <label>Hex Value</label>
        <input asp-for="HexValue" class="form-control" placeholder="#FFFFFF"/>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<a asp-action="Index" asp-controller="Color" class="btn btn-secondary">Back to List</a>
