@model ColorCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Add Color";
}

<h2>Add New Color</h2>

<form asp-action="Create" method="post">
    @await Html.PartialAsync("_ColorFormPartial", Model)
    <button type="submit" class="btn btn-success">Create</button>
</form>

<a asp-action="Index" asp-controller="Color" class="btn btn-secondary">Back to List</a>
