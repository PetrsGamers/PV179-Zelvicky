@model CapCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Cap";
}

<h2>Edit Cap</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_CapFormPartial", Model)
    <br />
    <button type="submit" class="btn btn-primary"
            onclick="return confirm('To maintain data quality, the cap cannot be edited directly. Our team will review your edit request soon, and if approved, the changes will be updated in the database.')">
        Save
    </button>
</form>

<br />
<a asp-action="Index" asp-controller="Cap" class="btn btn-secondary">Back to List</a>
