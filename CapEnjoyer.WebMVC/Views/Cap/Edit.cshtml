@model CapViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Cap";
}

<h2>Edit Cap</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Text On Cap</label>
        <input asp-for="TextOnCap" />
    </div>
    <div>
        <label>Description</label>
        <textarea asp-for="Description"></textarea>
    </div>
    <div>
        <label>Text Colors</label>
        <input asp-for="TextColors" />
    </div>
    <div>
        <label>Background Colors</label>
        <input asp-for="BgColors" />
    </div>
    <div>
        <label>Bottles</label>
        <input asp-for="Bottles" />
    </div>
    <div>
        <label>Cap Picture</label>
        <input asp-for="CapPicture" type="file" />
    </div>
    <button type="submit" onclick="return confirm('To maintain data quality, the cap cannot be edited directly. Our team will review your edit request soon, and if approved, the changes will be updated in the database.')">Save</button>
</form>

<a asp-action="Index" asp-controller="Cap">Back to List</a>
