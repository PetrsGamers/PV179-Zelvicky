@model CapCreateViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Cap";
}

<h2>Create Cap</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @await Html.PartialAsync("_CapFormPartial", Model)
    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</form>

<br />
<a asp-action="Index" asp-controller="Cap" class="btn btn-secondary">Back to List</a>
