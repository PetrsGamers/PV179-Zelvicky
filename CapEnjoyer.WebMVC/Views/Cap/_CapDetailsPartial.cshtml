@model CapDetailViewModel

<div>
    <h4>@Model.TextOnCap</h4>
    <p>Description: @Model.Description</p>

    <p>Text Colors:</p>
    <ul>
        @if (@Model.TextColors != null){
        @foreach (var color in Model.TextColors)
            {
                <li style="background-color:@color.HexCode; color:white">
                    @color.Name (@color.HexCode)
                </li>
            }
        }
    </ul>

    <p>Background Colors:</p>
    <ul>
        @if (@Model.BgColors != null){
        @foreach (var color in Model.BgColors)
        {
            <li style="background-color:@color.HexCode; color:white">
                @color.Name (@color.HexCode)
            </li>
        }
        }
    </ul>

    <p>Bottles:</p>
    <ul>
        @if (@Model.Bottles != null)
        {
            @foreach (var bottle in Model.Bottles)
            {
                <li>
                    <a asp-controller="Bottle" asp-action="Details" asp-route-id="@bottle.Id">
                        @bottle.Name
                    </a>
                </li>
            }
        }
    </ul>

    <img src="@Model.CapPicture" alt="@Model.TextOnCap"/>
</div>
